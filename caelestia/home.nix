# Home Manager integration for the official Caelestia dotfiles.
#
# The upstream files are vendored verbatim under ./hypr and ./foot (see
# https://github.com/caelestia-dots/caelestia). This module links them into
# ~/.config and applies the few NixOS-specific substitutions that cannot be
# expressed upstream.
{ lib, pkgs, ... }:

let
  hyprDir = ./hypr;

  relative = path: lib.removePrefix (toString hyprDir + "/") (toString path);

  # Link every file individually (instead of the whole directory) so that
  # Hyprland and the Caelestia CLI can keep writing `hypr/scheme/current.lua`
  # next to the read-only symlinks.
  hyprLinks = builtins.listToAttrs (
    map (
      path:
      lib.nameValuePair "hypr/${relative path}" {
        source = path;
        # `hyprland.lua` currently exists as a real, autogenerated file.
        force = true;
      }
    ) (lib.filesystem.listFilesRecursive hyprDir)
  );

  # `execs.lua` is kept byte-for-byte identical to upstream; only the two
  # hardcoded Arch Linux paths are rewritten to their nixpkgs equivalents.
  patchedExecs = builtins.replaceStrings
    [
      "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
      "/usr/lib/geoclue-2.0/demos/agent"
    ]
    [
      "${pkgs.polkit_gnome}/libexec/polkit-gnome-authentication-agent-1"
      "${pkgs.geoclue2}/libexec/geoclue-2.0/demos/agent"
    ]
    (builtins.readFile ./hypr/hyprland/execs.lua);

  # Upstream talks to Quickshell through `qs`, which is not exposed on PATH
  # here. The official CLI wraps the same operation as `caelestia shell -k`.
  patchedKeybinds = builtins.replaceStrings
    [
      "qs -c caelestia kill; sleep .1; caelestia shell -d"
      "qs -c caelestia kill"
    ]
    [
      "caelestia shell -k; sleep .1; caelestia shell -d"
      "caelestia shell -k"
    ]
    (builtins.readFile ./hypr/hyprland/keybinds.lua);

  # `qtengine` is an Arch Linux package. `qt6ct` is the nixpkgs equivalent and
  # implements the same `QT_QPA_PLATFORMTHEME` contract.
  patchedEnv = builtins.replaceStrings [ "qtengine" ] [ "qt6ct" ] (
    builtins.readFile ./hypr/hyprland/env.lua
  );

  # The official VSCodium settings point the Qt/QML extension at Arch paths.
  patchedVscodeSettings = builtins.replaceStrings
    [
      "/usr/lib/qt6/qml"
      "/usr/bin/qmlls6"
    ]
    [
      "${pkgs.qt6.qtdeclarative}/lib/qt-6/qml"
      "${pkgs.qt6.qtdeclarative}/bin/qmlls"
    ]
    (builtins.readFile ./vscode/settings.json);
in
{
  xdg.configFile = hyprLinks // {
    "hypr/hyprland/execs.lua".text = patchedExecs;
    "hypr/hyprland/keybinds.lua".text = patchedKeybinds;
    "hypr/hyprland/env.lua".text = patchedEnv;

    # Loaded by hyprland.lua and merged on top of the official `variables.lua`.
    "caelestia/hypr-vars.lua".text = ''
      -- NixOS overrides for Caelestia's Hyprland variables.
      -- Values returned here replace the official defaults from variables.lua.
      return {
          -- `sweet-cursors` is not packaged in nixpkgs; Bibata is the closest
          -- equivalent and is used by both XCURSOR_THEME and `hyprctl setcursor`.
          cursorTheme = "Bibata-Modern-Ice",
      }
    '';

    # Loaded last by hyprland.lua, after every official config file.
    "caelestia/hypr-user.lua".text = ''
      -- NixOS-specific overrides, applied after all official configs.

      -- The official config uses the US layout; this system uses `es`.
      hl.config({
          input = {
              kb_layout = "es",
          },
      })

      -- The official hyprland.lua uses scale = 1. Monitor rules are matched in
      -- order and the last matching rule wins, so this overrides it.
      hl.monitor({
          output   = "",
          mode     = "preferred",
          position = "auto",
          scale    = 1.25,
      })
    '';

    "foot/foot.ini".source = ./foot/foot.ini;

    # Official fastfetch layout, vendored verbatim.
    "fastfetch/config.jsonc".source = ./fastfetch/config.jsonc;

    # Official fish greeting. The rest of `fish/config.fish` is applied through
    # `programs.fish.interactiveShellInit` in ../home.nix, because Home Manager
    # generates that file itself.
    "fish/functions/fish_greeting.fish".source = ./fish/functions/fish_greeting.fish;

    "starship.toml".source = ./starship.toml;

    # btop rewrites its config when options are changed from the UI, so edits
    # made inside btop are not persisted through this read-only symlink.
    "btop/btop.conf".source = ./btop/btop.conf;

    # Thunar only rewrites these when custom actions / volume handling are
    # changed from its GUI.
    "Thunar/uca.xml".source = ./thunar/uca.xml;
    "Thunar/thunar-volman.xml".source = ./thunar/thunar-volman.xml;

    # Neovim colorscheme, generated from ~/.local/state/caelestia/scheme.json.
    "nvim/colors/caelestia.lua".source = ./nvim/colors/caelestia.lua;

    # lazy.nvim spec; harmless if lazy.nvim is not installed.
    "nvim/lua/plugins/caelestia.lua".source = ./nvim/lua/plugins/caelestia.lua;

    "VSCodium/User/settings.json".text = patchedVscodeSettings;
    "VSCodium/User/keybindings.json".source = ./vscode/keybindings.json;
    "codium-flags.conf".source = ./vscode/flags.conf;

    # Created empty by the official installer so users can add their own fish
    # configuration; `fish/config.fish` sources it if present.
    "caelestia/user-config.fish".text = ''
      # User-specific fish configuration, sourced by the Caelestia config.
    '';
  };

  # The Caelestia VSCodium extension provides the `Caelestia` colour theme that
  # `VSCodium/User/settings.json` selects. It is not published to the
  # marketplace, so install the vendored VSIX once (idempotent).
  home.activation.caelestiaVscodeExtension = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    if [ -x "${pkgs.vscodium}/bin/codium" ]; then
      if ! ${pkgs.vscodium}/bin/codium --list-extensions 2>/dev/null | grep -qx 'soramanew.caelestia-vscode-integration'; then
        ${pkgs.vscodium}/bin/codium --install-extension ${./vscode/caelestia-vscode-integration-1.2.0.vsix} --force >/dev/null 2>&1 || true
      fi
    fi
  '';

  # `gnome-keyring`, `ydotool` and `gpu-screen-recorder` are provided by the
  # system module in ./default.nix; `wl-clipboard` and `brightnessctl` are
  # already available from the system profile and the shell's own wrapper.
  home.packages = with pkgs; [
    # Applications referenced by the official variables / keybinds.
    foot # terminal
    thunar # file explorer
    pwvucontrol # audio settings
    fuzzel # launcher, clipboard and emoji picker
    cliphist # clipboard history
    trash-cli # `trash-empty` in execs.lua
    hyprpicker # colour picker
    grim # screenshots
    slurp # region selection
    swappy # screenshot annotation
    libnotify # notify-send

    # Session helpers started by execs.lua.
    polkit_gnome
    geoclue2
    gammastep
    bluez # mpris-proxy
    glib # gsettings
    gsettings-desktop-schemas

    # Shell prompt / prompt tooling from the official fish config.
    starship
    eza
    zoxide
    direnv

    # `killall -USR2 btop` when the CLI regenerates the btop theme.
    psmisc

    # Theming.
    bibata-cursors
    qt6Packages.qt6ct
  ];
}
